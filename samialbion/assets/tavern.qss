/* Sami Albion Manager — offline artisan's catalogue, v0.4.1 */
QWidget#root { background: #151a17; color: #f2e6cd; }
QWidget { font-family: "Segoe UI"; color: #eadfc8; font-size: 12px; }
QWidget#pageBody { background: transparent; }
QFrame#sideBar { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #2d231c,stop:0.55 #241c17,stop:1 #191613); border-right: 2px solid #765733; }
QFrame#sideBrand { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #35271d,stop:1 #251d17); border: 1px solid #60482e; border-bottom: 2px solid #b08145; border-radius: 8px; }
QFrame#panel { background: #222822; border: 1px solid #4d4937; border-radius: 14px; }
QFrame#panelWarm { background: #29291f; border: 1px solid #67533a; border-radius: 14px; }
QFrame#metric { background: #252b23; border: 1px solid #514934; border-radius: 13px; }
QLabel#brand { font-family: "Noto Serif"; font-size: 23px; font-weight: bold; color: #f5d59a; }
QLabel#brandSub { font-family: "Segoe UI"; color: #d2aa6b; font-size: 11px; font-weight: 600; letter-spacing: 1px; }
QFrame#sideBar QLabel#fieldCaption { color: #c79f61; font-size: 10px; font-weight: bold; }
QLabel#pageTitle { font-family: "Noto Serif"; font-size: 27px; font-weight: bold; color: #f4e3bf; }
QLabel#pageSub { color: #b4ad98; font-size: 11px; }
QLabel#sectionTitle { font-family: "Noto Serif"; font-size: 16px; font-weight: bold; color: #e9c384; }
QLabel#fieldCaption { font-family: "Segoe UI"; font-size: 11px; font-weight: 600; color: #c4b493; }
QLabel#metricTitle { color: #bbb497; font-size: 10px; font-weight: bold; }
QLabel#metricValue { color: #f9edcc; font-size: 20px; font-weight: bold; }
QLabel#metricHint { color: #a6ab98; font-size: 10px; }
QLabel#smallNote { color: #a5a58f; font-size: 10px; }
QLabel#pill { font-family: "Segoe UI"; background: #3a2c1f; border: 1px solid #937044; border-radius: 8px; padding: 5px 11px; color: #e9c68d; font-size: 11px; font-weight: 600; }
QLabel#woodPill { background: #473725; border: 1px solid #977548; border-radius: 9px; padding: 5px 11px; color: #e5c48a; font-size: 10px; font-weight: bold; }
QLabel#footerAuthor { color: #ead9bc; font-family: "Segoe UI"; font-size: 12px; }
QLabel#footerVersion { color: #38a9ee; font-family: "Segoe UI"; font-size: 12px; }
QPushButton#settingsGear { background: #33271e; border: 1px solid #7f6039; border-radius: 7px; color: #d7b67f; font-family: "Segoe UI Symbol"; font-size: 20px; padding: 0; }
QPushButton#settingsGear:hover, QPushButton#settingsGear[active="true"] { background: #6b4e2b; border-color: #dcb773; color: #fff0c8; }
QFrame#settingsPanel { background: #222822; border: 1px solid #61543c; border-radius: 13px; }
QLabel#settingsVersion { color: #d7c49b; font-size: 12px; }
QCheckBox#clickSoundCheckbox { color: #e7d7b9; spacing: 9px; font-size: 12px; }
QCheckBox#clickSoundCheckbox::indicator { width: 16px; height: 16px; }
QLabel#selectedHint { color: #a8b99b; font-size: 10px; }

QPushButton { outline: none; }
QPushButton#nav { background: #30271f; border: 1px solid #5a4732; border-radius: 7px; color: #d2b78e; font-size: 12px; text-align: left; padding: 13px 16px; }
QPushButton#nav:hover { background: #493623; border-color: #b18b51; color: #f9e4bb; }
QPushButton#nav[active="true"] { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #916c35,stop:0.45 #735127,stop:1 #523b25); border: 1px solid #d5a65d; color: #fff0c9; font-weight: bold; }
QPushButton#navSecondary { background: transparent; border: 1px solid transparent; border-radius: 10px; color: #c4bca6; font-size: 12px; text-align: left; padding: 11px 16px; }
QPushButton#navSecondary:hover { background: #30372d; border-color: #65583f; color: #f8dba2; }
QPushButton#navSecondary:disabled { color: #8c907f; }
QPushButton#primary { background: #dcb36d; color: #2a261c; border: 1px solid #efd096; border-radius: 9px; padding: 11px 16px; font-weight: bold; font-size: 11px; }
QPushButton#primary:hover { background: #f0ca89; border-color: #ffe6a5; }
QPushButton#primary:pressed { background: #ba9354; }
QPushButton#secondary { background: #343c32; color: #e4dabf; border: 1px solid #625a40; border-radius: 9px; padding: 10px 15px; font-weight: bold; }
QPushButton#secondary:hover { background: #434b3d; border-color: #ad945f; }
QPushButton#quiet { background: transparent; color: #c3b18d; border: 1px solid #534b37; border-radius: 8px; padding: 8px 14px; }
QPushButton#quiet:hover { color: #f6d698; border-color: #92764b; background: #302b23; }
QPushButton:disabled { background: #3c4038; color: #86897d; border-color: #55594e; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #171e1a; color: #f3e6c9; selection-background-color: #887047; border: 1px solid #686048; border-radius: 8px; padding: 9px 11px; min-height: 20px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #e4ba75; background: #1f261f; }
QLineEdit::placeholder { color: #858e81; }
QComboBox::drop-down { border: none; width: 25px; }
QComboBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #d9b977; width: 0; height: 0; margin-right: 12px; }
QComboBox QAbstractItemView { background: #252c24; color: #f1e2c1; border: 1px solid #786947; selection-background-color: #555a3e; outline: none; padding: 4px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 17px; background: #323b30; border: 0px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: none; border-left: 3px solid transparent; border-right: 3px solid transparent; border-bottom: 4px solid #cfad78; width: 0; height: 0; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: none; border-left: 3px solid transparent; border-right: 3px solid transparent; border-top: 4px solid #cfad78; width: 0; height: 0; }

QListWidget#suggestions { background: #262e26; color: #e8debf; border: 1px solid #85704d; border-radius: 9px; outline: 0; padding: 4px; }
QListWidget#suggestions::item { padding: 8px 9px; border-radius: 5px; }
QListWidget#suggestions::item:hover { background: #465441; }
QListWidget#suggestions::item:selected { background: #566544; color: #fff2ca; }

QTableWidget { background: #202821; alternate-background-color: #252e26; color: #ede4d0; border: 1px solid #4e523e; border-radius: 9px; gridline-color: #354034; outline: none; selection-background-color: #475841; selection-color: #fff1d2; }
QTableWidget::item { padding: 8px; border-bottom: 1px solid #394437; }
QHeaderView::section { background: #313b2e; color: #e4c58c; font-weight: bold; border: none; border-bottom: 1px solid #6a6347; padding: 10px 7px; }
QScrollBar:vertical { background: #1b241f; width: 9px; margin: 1px; }
QScrollBar::handle:vertical { background: #665d45; border-radius: 4px; min-height: 25px; }
QScrollBar::handle:vertical:hover { background: #a58b5c; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar:horizontal { background: #1b241f; height: 8px; }
QScrollBar::handle:horizontal { background: #665d45; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* Clean-slate workshop and compact arithmetic drawer. */
QFrame#emptyWorkbench { background: #1d241f; border: 1px solid #4c4b38; border-radius: 16px; }
QLabel#emptySymbol { color: #b39362; font-family: Georgia; font-size: 37px; }
QLabel#emptyTitle { font-family: "Noto Serif"; font-size: 25px; color: #edd3a2; font-weight: bold; }
QPushButton#drawerToggle { font-family: "Segoe UI"; background: #4d3824; color: #f3d398; border: 1px solid #ac8550; border-radius: 7px; padding: 6px 11px; font-size: 12px; font-weight: 600; text-align: left; }
QPushButton#drawerToggle:hover { background: #6a4b2d; border-color: #ddad63; }
QPushButton#drawerToggle[active="false"] { background: #30261e; color: #d0b38d; }
QFrame#calcDrawer { background: #30251c; border: 1px solid #8b663c; border-radius: 9px; }
QFrame#calcDisplay { background: #1f1915; border: 1px solid #7d603b; border-radius: 7px; }
QLabel#calcHistory { font-size: 9px; color: #a9a991; }
QLabel#calcValue { font-size: 21px; font-weight: bold; color: #f2e1be; }
QPushButton#calcNumber, QPushButton#calcOperator, QPushButton#calcUtility, QPushButton#calcEquals { border-radius: 6px; font-size: 12px; font-weight: bold; padding: 2px; }
QPushButton#calcNumber { background: #3c4438; color: #f2e6cd; border: 1px solid #59644f; }
QPushButton#calcNumber:hover { background: #55614c; border-color: #8e9e7d; }
QPushButton#calcUtility { background: #3e382b; color: #e4c991; border: 1px solid #776748; }
QPushButton#calcUtility:hover { background: #594b33; }
QPushButton#calcOperator { background: #524831; color: #f1d59f; border: 1px solid #89714c; }
QPushButton#calcOperator:hover { background: #6a593b; }
QPushButton#calcEquals { background: #dfb775; color: #29251b; border: 1px solid #ffe0a0; }
QPushButton#calcEquals:hover { background: #f1cf8c; }
QPushButton#calcNumber:pressed, QPushButton#calcOperator:pressed, QPushButton#calcUtility:pressed, QPushButton#calcEquals:pressed { background: #a98d60; color: #241e16; }

/* Market-hub-inspired artisan theme: dark timber, gold controls, parchment rows. */
QLabel#catalogueTitle { font-family: "Noto Serif"; font-size: 23px; font-weight: bold; color: #f1cf91; }
QLabel#catalogueSubtitle { color: #bea98e; font-size: 11px; }
QLabel#catalogueCount { color: #e8bb69; font-size: 12px; font-weight: 600; }
QFrame#catalogueFilters { background: #30241b; border: 1px solid #80613b; border-radius: 10px; }
QLineEdit#catalogueSearch { background: #e4d4ba; color: #4b3525; border: 2px solid #8e7150; border-radius: 17px; padding-left: 16px; font-size: 12px; selection-background-color: #a88654; }
QLineEdit#catalogueSearch:focus { background: #f2e5ce; border-color: #d9ac56; }
QLineEdit#catalogueSearch::placeholder { color: #856f5b; }
QPushButton#resetFilters { background: #4e4e4c; color: #f0ddb5; border: 1px solid #a88d63; border-radius: 17px; padding: 6px 12px; font-size: 11px; font-weight: 600; }
QPushButton#resetFilters:hover { background: #69543a; border-color: #e6bf75; color: #fff2d3; }
QPushButton#resetFilters:pressed { background: #897047; }
QComboBox#catalogueFilter { background: #e2d2b7; color: #422f24; border: 1px solid #8d765a; border-radius: 15px; padding: 6px 12px; font-size: 11px; }
QComboBox#catalogueFilter:hover { background: #f0e2c9; border-color: #d1a660; }
QComboBox#catalogueFilter:focus { background: #f3e5cb; border-color: #c49c56; }
QTableView#itemsTable { background: #e5d7c4; alternate-background-color: #d9c9b3; border: 3px solid #756048; border-radius: 5px; color: #493424; gridline-color: #b7a58d; font-size: 12px; outline: none; selection-background-color: #e4c98f; selection-color: #33271d; }
QTableView#itemsTable::item { padding: 3px 8px; border: none; border-bottom: 1px solid #c7b59d; }
QTableView#itemsTable::item:selected { background: #e4c98f; color: #33271d; }
QTableView#itemsTable QHeaderView::section { background: #d3c0a5; color: #63442e; border: none; border-bottom: 2px solid #aa8e67; font-family: "Noto Serif"; font-weight: bold; padding: 10px 7px; }
QFrame#itemDetail { background: #302820; border: 1px solid #93734b; border-radius: 10px; }
QLabel#detailCaption { font-family: "Noto Serif"; font-size: 12px; font-weight: bold; color: #e3b968; }
QLabel#detailName { font-family: "Noto Serif"; color: #f6dbab; font-size: 17px; font-weight: bold; }
QLabel#detailData { color: #dfd0b7; font-family: "Segoe UI"; font-size: 11px; }

/* Market-style, three-tier submenus with calm selection highlights. */
QPushButton#marketCategoryButton { background: #e2d2b7; color: #422f24; border: 1px solid #8d765a; border-radius: 15px; padding-top: 7px; padding-bottom: 7px; padding-left: 18px; padding-right: 12px; font-size: 11px; text-align: left; }
QPushButton#marketCategoryButton:hover { background: #f0e2c9; border-color: #d1a660; }
QPushButton#marketCategoryButton::menu-indicator { subcontrol-origin: padding; subcontrol-position: center right; width: 14px; height: 12px; }
QMenu#marketMenu { background: #3d3529; color: #f3e4c9; border: 1px solid #947653; padding: 3px; font-family: "Segoe UI"; font-size: 11px; }
QMenu#marketMenu::item { padding: 4px 16px 4px 8px; margin: 0; border-radius: 3px; }
QMenu#marketMenu::item:selected { background: #81704e; color: #fff4d9; }
QMenu#marketMenu::item:disabled { color: #918775; }
QMenu#marketMenu::separator { height: 1px; background: #6b6048; margin: 3px 6px; }

/* Crafting profitability workbench. */
QFrame#craftPanel { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #3e2e22,stop:1 #291e18); border: 1px solid #a07b4e; border-radius: 10px; }
QFrame#craftPricePanel { background: #dfcfb9; border: 2px solid #a48460; border-radius: 9px; }
QFrame#craftFeePanel { background: #32271e; border: 1px solid #947047; border-radius: 9px; }
QFrame#craftMetric { background: #dfcfb9; border: 1px solid #a48460; border-radius: 9px; }
QLabel#craftMetricCaption { color: #7d5b36; font-size: 10px; font-weight: bold; }
QLabel#craftMetricValue { color: #4d3521; font-family: "Noto Serif"; font-size: 17px; font-weight: bold; }
QLabel#craftField { color: #e8c999; font-size: 11px; font-weight: 600; }
QFrame#craftPricePanel QLabel#craftField { color: #5d412b; }
QLabel#craftResource { color: #f0e1c4; font-size: 12px; }
QLabel#craftExplanation { color: #755b3f; font-size: 11px; }
QLabel#craftBreakdown { background: #2d241c; color: #f0d6a8; border: 1px solid #967047; border-radius: 7px; padding: 12px; font-size: 11px; }
QCheckBox#craftCheckbox { color: #f3e3c7; font-size: 12px; spacing: 9px; }
QCheckBox#craftCheckbox::indicator { width: 17px; height: 17px; background: #e8d7bd; border: 1px solid #95724a; border-radius: 3px; }
QCheckBox#craftCheckbox::indicator:checked { background: #d4ad69; border: 2px solid #f0ce8e; }
QCheckBox#craftCheckbox::indicator:unchecked { background: #e8d7bd; border: 1px solid #95724a; }
QListWidget#craftResults { background: #e5d7c4; alternate-background-color: #d9c9b3; color: #483324; border: 2px solid #756048; border-radius: 5px; outline: 0; }
QListWidget#craftResults::item { color: #493424; min-height: 44px; padding: 4px; border-bottom: 1px solid #c7b59d; }
QListWidget#craftResults::item:selected { background: #e4c98f; color: #33271d; }
QListWidget#craftResults::item:hover { background: #efd6a7; }
QComboBox#craftFilter { background: #e2d2b7; color: #422f24; border: 1px solid #8d765a; border-radius: 11px; padding: 7px; }
QComboBox#craftFilter QAbstractItemView { background: #3d3529; color: #f3e4c9; selection-background-color: #81704e; }
QSpinBox#craftNumber { background: #e8d7bd; color: #422f24; border: 1px solid #8d765a; border-radius: 8px; padding: 7px 9px; min-width: 115px; }
QSpinBox#craftNumber:focus { background: #f6e9d0; border-color: #dfba77; }
QDoubleSpinBox#craftNumber { background: #e8d7bd; color: #422f24; border: 1px solid #8d765a; border-radius: 8px; padding: 7px 9px; min-width: 115px; }
QDoubleSpinBox#craftNumber:focus { background: #f6e9d0; border-color: #dfba77; }
QScrollArea#craftScroll { border: none; background: transparent; }

/* v0.4.2: compact explicit craft quantity controls */
QPushButton#craftStepButton { background: #62492f; color: #f7e1b4; border: 1px solid #a68759; border-radius: 5px; font-family: "Segoe UI"; font-size: 16px; font-weight: bold; padding: 0; }
QPushButton#craftStepButton:hover { background: #84623e; color: #fff4dd; border-color: #dfb875; }
QPushButton#craftStepButton:pressed { background: #ad854e; color: #21180f; }
QPushButton#craftStepButton:disabled { background: #453c33; color: #8c816e; border-color: #6a5944; }

/* v0.4.4: separate visible craft inputs (not Qt's embedded spinbox editor). */
QLabel#craftNumberUnit { color: #dfc89d; background: transparent; font-size: 10px; padding: 0 3px; }
QFrame#craftPricePanel QLabel#craftNumberUnit { color: #5d412b; }
